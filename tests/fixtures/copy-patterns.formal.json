{
 "about": "Bulgarian, formal 'вие'. Flags informal address for review; a customer's own first-person words are fine. Many singular imperatives look like a past-tense verb ('Мария потвърди'), so those are flagged only where a sentence starts; the -й imperatives never clash and are flagged anywhere. Copy this file per project and add its false positives to ignore_words or allow.",
 "flags": [
  {
   "name": "informal pronoun",
   "regex": "(?<![А-Яа-я])(ти|теб|твой|твоя|твое|твоите|твоят|си писал|си работил|си избрал)(?![А-Яа-я])"
  },
  {
   "name": "informal verb (-ш)",
   "regex": "(?<![А-Яа-я])[А-Яа-я]{3,}ш(?![А-Яа-я])"
  },
  {
   "name": "informal greeting",
   "regex": "(?<![А-Яа-я])(Здравей|Добре дошъл|Добре дошла)(?![А-Яа-я])"
  },
  {
   "name": "informal imperative, sentence start",
   "case": true,
   "regex": "(?:^|[.!?:;·•„\"(]\\s*)(Опиши|Разкажи|Напиши|Пиши|Избери|Сподели|Виж|Добави|Поеми|Купи|Плати|Влез|Въведи|Смени|Покажи|Затвори|Отвори|Изпрати|Остави|Наеми|Прочети|Предложи|Направи|Запази|Поправи|Сравни|Продължи|Отмени|Изтегли|Изтрий|Задай|Подай|Пусни|Откажи|Отхвърли|Потвърди|Върни|Кажи|Свали|Задръж|Покани|Обнови|Промени|Премахни|Махни|Стани|Създай|Започни|Вземи|Обади|Провери|Отговори|Включи|Изключи|Разшири|Подреди|Изчисти|Скрий|Спри|Прикачи|Приближи|Отдалечи|Съкрати|Натисни|Погледни|Търси|Потърси)(?![А-Яа-я])"
  },
  {
   "name": "informal imperative, anywhere",
   "regex": "(?<![А-Яа-я])(Разгледай|Поискай|Публикувай|Опитай|Презареди|Снимай|Чакай|Казвай|Сваляй|Пращай|Внимавай|Опиши|Разкажи|Напиши|Сравни|Покажи|Кажи|Махни|Купи|Влез|Въведи|Задай|Подай|Пусни)(?![А-Яа-я])"
  },
  {
   "name": "informal phrase, anywhere",
   "regex": "(?<![А-Яа-я])(Свържи се|свържи се|Обади се|обади се|Регистрирай се|Абонирай се|Цитирай|цитирай|Копирай|копирай|Изчакай|Използвай|Опитай|опитай|Заяви|Първо избери|първо избери|Натисни|Попълни|ще получиш|можеш|търсиш|намираш|искаш|имаш|твоята|твоя|твоите|с теб|за теб)(?![А-Яа-я])"
  },
  {
   "name": "informal adjective to the reader",
   "regex": "(?<![А-Яа-я])(Заинтересован|Сигурен ли си|Готов ли си)(?![А-Яа-я])"
  }
 ],
 "ignore_words": [
  "АД",
  "БНБ",
  "ВиК",
  "ГТП",
  "ДДС",
  "ЕАД",
  "ЕГН",
  "ЕИК",
  "ЕООД",
  "ЕС",
  "ЕТ",
  "КАТ",
  "КЗЛД",
  "КЗП",
  "МВР",
  "НАП",
  "НЗОК",
  "НОИ",
  "ООД",
  "САЩ",
  "бранш",
  "ваш",
  "душ",
  "кеш",
  "марш",
  "наш",
  "туш",
  "фиш"
 ],
 "allow": []
}
