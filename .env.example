# Hera Editing site: configuration. Copy to .env.local for development; set the same names in the host for
# staging and production. Placeholders only: never commit real values. Production refuses to build or start while
# a required value is missing or invalid (src/lib/config/env.ts names the variable, never the value).

# --- Environment ---------------------------------------------------------------------------------------------
# development | test | staging | production. On Vercel, production and preview are detected automatically.
APP_ENV=development

# --- Public identity (owner launch inputs; read at build time by the static pages) ---------------------------
# The real https address in production (canonical links, share cards, sitemap, structured data).
NEXT_PUBLIC_SITE_URL=https://www.example.bg
# The brand as it should appear in titles and structured data (required in production).
NEXT_PUBLIC_BRAND_NAME=Hera Editing
# Verified public contacts: at least one is required in production. Leave empty until verified.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# --- Database (secret) -----------------------------------------------------------------------------------------
# Postgres, EU region when feasible. Locally: `pnpm db:dev` prints a ready value.
DATABASE_URL=postgres://user:password@host:5432/database

# --- Owner alerts for new enquiries ------------------------------------------------------------------------------
NOTIFICATION_EMAIL_TO=owner@example.bg
# resend | smtp | dev (dev writes alerts to the console or MAIL_DEV_OUTBOX_DIR; refused in production)
MAIL_PROVIDER=dev
# The sender on a verified domain (resend), or SMTP_FROM for smtp.
MAIL_FROM=Hera Editing <noreply@example.bg>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Development only: a folder for alert files instead of the console.
MAIL_DEV_OUTBOX_DIR=

# --- Abuse protection (secret) -----------------------------------------------------------------------------------
# Random, at least 32 characters (e.g. `openssl rand -hex 32`). Required outside development and test.
RATE_LIMIT_SALT=
# Trust X-Forwarded-For for the client address (Vercel sets it reliably and is detected automatically).
TRUST_PROXY=false
# Optional Cloudflare Turnstile: both or neither. Adds Cloudflare as a processor (privacy notice).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Scheduled alert retry ---------------------------------------------------------------------------------------
# Enables GET /api/cron/lead-notifications (Vercel Cron sends it as a Bearer token). At least 32 characters.
CRON_SECRET=

# --- Admin panel at /admin (off until both are set; decision L32) ------------------------------------------------
# One password (at least 12 characters) and a random session secret (at least 32; rotating it signs everyone out).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- The contact@ mailbox (off until all three are set, with RESEND_API_KEY above) -------------------------------
# The shared inbox; only mail to its domain is recorded. Replies from the panel leave from it.
MAILBOX_ADDRESS=
# The signing secret of the Resend webhook (email.received -> https://<site>/api/inbound), whsec_...
RESEND_WEBHOOK_SECRET=
# NOTIFICATION_EMAIL_TO above also receives a copy of every recorded message, Reply-To the sender.

# --- The English section /en (decision L38) ----------------------------------------------------------------------
# true | false. Empty: off in production, on everywhere else (staging and previews show it for review). Read at build
# time by the static pages, the sitemap and the Bulgarian footer's link: rebuild after changing it. Production refuses
# to build with it on until the package terms are signed off (src/content/en/terms.ts) and the English privacy notice
# is approved (src/content/en/legal/privacy.ts).
EN_SECTION_ENABLED=
# true | false (default false). Orders from businesses in other EU states (not Bulgaria) need the art. 97а VAT
# registration first: until then the order form and POST /api/orders refuse them. Read per request.
EN_EU_ORDERS=false

# --- Optional analytics (off by default; loads only after the visitor accepts) -------------------------------
# Both are needed, and read at build time: the GA4 id and the owner's confirmation that the consent setup and the
# cookie notice were approved.
ANALYTICS_MEASUREMENT_ID=
ANALYTICS_CONSENT_APPROVED=false

# --- Optional ------------------------------------------------------------------------------------------------------
# Search Console ownership by meta tag (DNS verification needs nothing here).
GOOGLE_SITE_VERIFICATION=
# Preview the production look (designed frames instead of the labelled stock footage) outside production.
PLACEHOLDER_MEDIA=on
