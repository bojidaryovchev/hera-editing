          "value": "\"leads\".\"phone\" is null or char_length(\"leads\".\"phone\") <= 40"
        },
        "leads_profile_len": {
          "name": "leads_profile_len",
          "value": "\"leads\".\"profile_url\" is null or char_length(\"leads\".\"profile_url\") <= 250"
        },
        "leads_message_len": {
          "name": "leads_message_len",
          "value": "\"leads\".\"message\" is null or char_length(\"leads\".\"message\") <= 2000"
        },
        "leads_attempts_nonneg": {
          "name": "leads_attempts_nonneg",
          "value": "\"leads\".\"notification_attempts\" >= 0"
        },
        "leads_bg_fields": {
          "name": "leads_bg_fields",
          "value": "\"leads\".\"locale\" <> 'bg' or (\"leads\".\"city\" is not null and \"leads\".\"goal\" is not null)"
        },
        "leads_en_fields": {
          "name": "leads_en_fields",
          "value": "\"leads\".\"locale\" <> 'en' or (\"leads\".\"details\" is not null and \"leads\".\"email\" is not null)"
        },
        "leads_details_size": {
          "name": "leads_details_size",
          "value": "\"leads\".\"details\" is null or octet_length(\"leads\".\"details\"::text) <= 32768"
        }
